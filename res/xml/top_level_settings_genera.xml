<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="top_level_genera"
    android:title="@string/genera_title" >

    <!-- Gesture -->
    <PreferenceCategory
        android:key="kategori_gesture"
        android:order="-2"
        android:selectable="false"
        android:title="@string/kategori_gesture" />

    <!-- Three-fingers-swipe to screenshot -->
    <org.genera.settings.preferences.SystemSettingSwitchPreference
        android:icon="@drawable/ic_swipe_to_screenshot"
        android:key="three_finger_gesture"
        android:order="-1"
        android:summary="@string/three_finger_gesture_summary"
        android:title="@string/three_finger_gesture"
        android:defaultValue="false" />

    <!-- Statusbar -->
    <PreferenceCategory
        android:key="kategori_statusbar"
        android:order="1"
        android:selectable="false"
        android:title="@string/kategori_statusbar" />

    <!-- 4G Icon -->
    <org.genera.settings.preferences.SystemSettingSwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_switch_to_4g"
        android:key="show_fourg_icon"
        android:order="2"
        android:summary="@string/show_fourg_icon_summary"
        android:title="@string/show_fourg_icon_title" />

    <!-- Background Chip Clock -->
    <org.genera.settings.preferences.SystemSettingSwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_clock_bg"
        android:key="statusbar_clock_chip"
        android:summary="@string/statusbar_clock_chip_summary"
        android:title="@string/statusbar_clock_chip_title" />

    <!-- Battery Bar -->
    <PreferenceScreen
        android:fragment="org.genera.settings.statusbar.BatteryBar"
        android:icon="@drawable/ic_battery_bar"
        android:key="batterybar"
        android:order="3"
        android:summary="@string/battery_bar_summary"
        android:title="@string/battery_bar_title" />

    <!-- Call strenght icon -->
    <org.genera.settings.preferences.SecureSettingSwitchPreference
        android:icon="@drawable/ic_call_strenght"
        android:key="hide_qs_call_strength"
        android:order="4"
        android:title="@string/show_qs_call_strength_icon_title"
        android:summary="@string/show_qs_call_strength_icon_summary"
        android:defaultValue="false" />

    <!-- Combined Signal Icon -->
    <org.genera.settings.preferences.SystemSettingSwitchPreference
        android:icon="@drawable/ic_combined_signal"
        android:key="combined_status_bar_signal_icons"
        android:order="5"
        android:summary="@string/combined_status_bar_signal_icons_summary"
        android:title="@string/combined_status_bar_signal_icons_title" />

    <!-- Statusbar Logo -->
    <org.genera.settings.preferences.SystemSettingSwitchPreference
        android:icon="@drawable/ic_statusbar_logo"
        android:key="status_bar_logo"
        android:order="6"
        android:title="@string/status_bar_logo_title"
        android:summary="@string/status_bar_logo_summary" />

</PreferenceScreen>
